export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
export PATH="/Users/iw/.opencode/bin:$PATH"
export NVM_DIR="$HOME/.nvm"
[ -s "$(brew --prefix nvm)/nvm.sh" ] && \. "$(brew --prefix nvm)/nvm.sh"

export HOMEBREW_NO_ENV_HINTS=1

export EDITOR="zed --wait"
export VISUAL="zed --wait"

export JJ_EDITOR="zed --wait"

export ZSH="$HOME/.oh-my-zsh"

export GLAB_PAGER=cat

plugins=(
    bgnotify
    chezmoi
    git
    copypath
    fzf
    npm
    nvm
    rust
    stack
    screen
    uv
    zsh-autosuggestions
)

zstyle ':omz:update' mode reminder
ZSH_THEME="gentoo"
COMPLETION_WAITING_DOTS="true"

fpath=(/opt/homebrew/share/zsh/site-functions $fpath)

source $ZSH/oh-my-zsh.sh

# TMOUT=1
# function _prompt_refresh() { zle && zle reset-prompt }
# TRAPALRM() { _prompt_refresh; }

alias q=¬"exit"
alias c="clear"
alias gc="git clone"
alias gs="git status"
alias m="make"
alias mr="make run"
alias sdn="shutdown -P now"
alias ll="ls -al"
zstyle ':vcs_info:*' enable NONE

alias gl=glab
alias tidy="/opt/homebrew/bin/tidy"
alias mymrs='glab mr list --author @me --output=json | jq -r '"'"'.[] | "!\(.iid)\n\(if .draft then "draft" else .detailed_merge_status end)\n\(.title)\n\(.web_url)", ""'"'"
alias vim="nvim"

alias lightbg="osascript -e 'tell application \"System Events\" to set picture of every desktop to \"/Users/iw/Pictures/backgrounds/white.png\"'"
alias darkbg="osascript -e 'tell application \"System Events\" to set picture of every desktop to \"/Users/iw/Pictures/backgrounds/black.png\"'"

fpath+=~/.zfunc

autoload -U compinit; compinit

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/opt/anaconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/opt/anaconda3/etc/profile.d/conda.sh" ]; then
        . "/opt/anaconda3/etc/profile.d/conda.sh"
    else
        export PATH="/opt/anaconda3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

test -e "${HOME}/.iterm2_shell_integration.zsh" && source "${HOME}/.iterm2_shell_integration.zsh" || true

fpath+=~/.zfunc; autoload -Uz compinit; compinit

if [[ -f ~/.zshrc.local ]]; then
    source ~/.zshrc.local
fi
export PATH="$HOME/.local/bin:$PATH"

export PATH=/opt/homebrew/share/google-cloud-sdk/bin:"$PATH"

source /opt/homebrew/share/google-cloud-sdk/completion.zsh.inc

bindkey -e
