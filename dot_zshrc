export JJ_EDITOR="zed --wait"

export ZSH="$HOME/.oh-my-zsh"

export GLAB_PAGER=cat

plugins=(
    bgnotify
    chezmoi
    git
    copypath
    fzf
    npm
    rust
    stack
    screen
    uv
    zsh-autosuggestions
)

zstyle ':omz:update' mode reminder
ZSH_THEME="gentoo"
