[
    {
        "context": "(Workspace && !Terminal)",
        "bindings": {},
    },
    {
        "context": "Editor",
        "bindings": {
            "cmd-/": "agent::Toggle",
            // "shift-enter": [
            //     "task::Spawn",
            //     {
            //         "task_name": "Tidal: Evaluate Paragraph"
            //     }
            // ],
            // "shift-alt-enter": [
            //     "task::Spawn",
            //     {
            //         "task_name": "Tidal: Evaluate Selection"
            //     }
            // ],
            // "ctrl-.": [
            //     "task::Spawn",
            //     {
            //         "task_name": "Tidal: Hush"
            //     }
            // ]
        },
    },
    {
        "context": "AgentPanel",
        "bindings": {
            "escape": "agent::ToggleFocus",
        },
    },
    {
        "context": "Workspace && os == macos",
        "bindings": {
            "cmd-/": "agent::ToggleFocus",
            "cmd-p": "command_palette::Toggle",
        },
    },

    {
        "context": "Editor",
        "bindings": {
            "cmd-.": null,
        },
    },
    {
        "bindings": {
            "cmd-l": "project_panel::Toggle",
            "cmd-g": "git_panel::Toggle",
            "cmd-shift-r": "debugger::Start",
            "cmd-.": "file_finder::Toggle",
            "cmd-r": "task::Spawn",
            "cmd-'": "git::CheckoutBranch",
            "cmd-\"": "git::Switch"
        },
    },
    {
        "context": "Editor",
        "unbind": {
            "cmd-'": "editor::ToggleSelectedDiffHunks"
        }
    },
    {
        "bindings": {
            "cmd-;": "git_graph::Open"
        }
    },
    {
        "context": "Editor",
        "unbind": {
            "cmd-d": [
                "editor::SelectNext",
                {
                    "replace_newest": false
                }
            ]
        }
    },
    {
        "context": "Terminal",
        "unbind": {
            "cmd-d": "pane::SplitRight"
        }
    },
    {
        "context": "Terminal",
        "bindings": {
            "cmd-n": "workspace::NewTerminal"
        }
    },
    {
        "context": "ProjectPanel",
        "unbind": {
            "cmd-d": "project_panel::Duplicate"
        }
    },
    {
        "bindings": {
            "cmd-d": "git::BranchDiff"
        }
    },
    {
        "bindings": {
            "cmd-m": "workspace::ToggleZoom"
        }
    },
    {
        "unbind": {
            "shift-escape": "workspace::ToggleZoom"
        }
    },
    {
        "context": "Workspace",
        "unbind": {
            "cmd-t": "project_symbols::Toggle"
        }
    },
    {
        "bindings": {
            "cmd-t": "text_finder::Toggle"
        }
    },
    {
        "bindings": {
            "cmd-ctrl-left": "workspace::ActivatePaneLeft",
            "cmd-ctrl-right": "workspace::ActivatePaneRight",
            "cmd-ctrl-up": "workspace::ActivatePaneUp",
            "cmd-ctrl-down": "workspace::ActivatePaneDown"
        }
    },
    {
        "bindings": {
            "alt-]": "editor::GoToHunk",
            "alt-[": "editor::GoToPreviousHunk"
        }
    },
    {
        "context": "GitPanel",
        "bindings": {
            "alt-enter": "git::ViewFile"
        }
    }
]
